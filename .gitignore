# Node / TypeScript (pnpm monorepo)
node_modules/
dist/
build/
*.tsbuildinfo
coverage/
.turbo/
.pnpm-store/

# Env
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.log

# Cycle (.claude/) — Python tooling caches & local artifacts
.claude/**/__pycache__/
.claude/**/*.pyc
.claude/.mypy_cache/
.claude/.ruff_cache/
.claude/.pytest_cache/
.claude/.hypothesis/

# Cycle local state (not part of the committed kit)
.active_plan
.progress-*.json
.compaction-snapshots/

# SOTA reference clones (study-only material — never committed; see references-catalog.md)
knowledge-base/references/

# Cross-validation run artifacts (audit output incl. binary SQLite DB — not versioned)
cross-validation-output/

# Cópias datadas que o instalador do kit cria a cada propagação
# (.claude/.patch-backups/<timestamp>/…). São backup local de recuperação —
# versioná-las duplicaria no histórico o que o próprio git já guarda.
.claude/.patch-backups/

# Halt-loop runtime (ralph-loop) — per-invocation, never versioned
halt-loop-prompts/
.claude/ralph-loop.local.md
.claude/knowledge-base/implementations/.progress-*.json

# The Squad kit and the data it writes — a dependency and an output, kept apart.
#
# `.claude/` is an INSTALLED PLUGIN with a repository of its own, so a copy inside a
# consumer is a dependency and not this project's source. Versioning it made every
# adopting repo carry hundreds of permanently dirty files that no `git checkout` could
# settle, because a reinstall rewrites them.
#
# `.squad/` is this PROJECT'S data: `records/` is a dated trail written per machine,
# `wiki/` is the consolidated bundle. Separate roots so the versioning question is
# answerable for each on its own terms.
#
# `.squad/*` and not `.squad/`: git does not descend into an excluded DIRECTORY, so the
# negation below would never fire and new wiki pages would be dropped in silence.
.claude/
.squad/*
!.squad/wiki/
