{
  "name": "@usetheo/skills-cli",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "theoskill": "./dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' --no-error-on-unmatched-pattern",
    "test": "vitest run --config vitest.contract.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@usetheo/skills": "workspace:*",
    "yazl": "^3.3.1",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "@usetheo/skills-api": "workspace:*",
    "typescript": "^5.4.0",
    "vitest": "^4.0.0"
  },
  "description": "CLI do theo-skills — publicar, instalar e atualizar skills de agentes.",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheoai/theo-skills.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  }
}
