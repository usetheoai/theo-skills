{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    // O `cli` importa `@usetheo/skills-api/validators`; sem declarations o consumidor não
    // resolve os tipos do subpath export.
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "tests", "eval", "**/*.test.ts"]
}
